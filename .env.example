# PostgreSQL connection (used in local / Docker environments)
# When omitted in AI Studio preview, the server persists to the configured Cloud Firestore instance.
DATABASE_URL="postgresql://sweety:sweety_password@localhost:5432/sweety"

# JWT signing secret for user sessions
JWT_SECRET="replace-with-a-long-random-secret"

# Application URL
APP_URL="http://localhost:3000"
