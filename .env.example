# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Authentication
# Replace with a strong random secret before deploying
JWT_SECRET="replace-with-a-strong-random-secret"

# PostgreSQL Connection (Primary)
# Provide DATABASE_URL or the individual PG* variables below.
# When omitted, the server falls back to the configured Cloud Firestore database.
DATABASE_URL="postgresql://sweety:sweety_password@localhost:5432/sweety"

# Alternative individual PostgreSQL parameters (optional if DATABASE_URL is set)
# PGHOST="localhost"
# PGPORT=5432
# PGUSER="sweety"
# PGPASSWORD="sweety_password"
# PGDATABASE="sweety"
